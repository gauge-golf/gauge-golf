# Neon Postgres connection string (pooled).
# Get this from: https://console.neon.tech → your project → Connection Details → Pooled connection.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# OpenAI API key (for Coach AI analysis).
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# Resend API key (passwordless OTP email).
# Get this from: https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Sender for OTP emails. Domain must be verified in Resend.
RESEND_FROM="Gauge Golf <hello@gauge-golf.com>"

# Secret for signing the auth session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET="<64-char hex string>"
